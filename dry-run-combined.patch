+import { test, expect, type Page } from "@playwright/test";
+
+// デザイン(design/project 版9)との差分監査 行6・47・48・49 の測定テスト。
+// 値は getComputedStyle で測る（見た目の目視ではなく数値で固定する）。
+
+type Theme = "light" | "dark";
+
+async function open(page: Page, theme: Theme) {
+  // テーマはアプリ自身の保存キーで指定する（use-theme.ts の STORAGE_KEY）。
+  await page.addInitScript((t) => localStorage.setItem("sudden-death-theme", t), theme);
+  await page.goto("/");
+  await expect(page.locator("html")).toHaveAttribute("data-theme", theme);
+}
+
+const read = (page: Page) =>
+  page.evaluate(() => {
+    const toggle = getComputedStyle(document.querySelector(".theme-toggle")!);
+    const card = getComputedStyle(document.querySelector(".card")!);
+    const body = getComputedStyle(document.body);
+    return { toggleShadow: toggle.boxShadow, cardShadow: card.boxShadow, bodyBg: body.backgroundImage };
+  });
+
+for (const theme of ["light", "dark"] as const) {
+  test(`${theme}: テーマ切替ボタンに影が無い（行6・49）`, async ({ page }) => {
+    await open(page, theme);
+    expect((await read(page)).toggleShadow).toBe("none");
+  });
+}
+
+test("light: カードの影はデザインの --sh のまま残る", async ({ page }) => {
+  await open(page, "light");
+  const { cardShadow } = await read(page);
+  expect(cardShadow).toContain("rgba(31, 43, 92, 0.35)");
+  expect(cardShadow).toContain("rgba(31, 43, 92, 0.12)");
+});
+
+test("dark: カードの影が無い（行47, --sh:none）", async ({ page }) => {
+  await open(page, "dark");
+  expect((await read(page)).cardShadow).toBe("none");
+});
+
+test("dark: 背景グラデーションは #141824 → #0a0c12 でアルファ無し（行48）", async ({ page }) => {
+  await open(page, "dark");
+  expect((await read(page)).bodyBg).toBe("linear-gradient(160deg, rgb(20, 24, 36), rgb(10, 12, 18))");
+});
+
+test("light: 背景グラデーションは #eef2fb → #e4e9f5", async ({ page }) => {
+  await open(page, "light");
+  expect((await read(page)).bodyBg).toBe("linear-gradient(160deg, rgb(238, 242, 251), rgb(228, 233, 245))");
+});
diff --git a/tests/e2e/design-disabled-cursor.spec.ts b/tests/e2e/design-disabled-cursor.spec.ts
new file mode 100644
index 0000000..3b81073
--- /dev/null
+++ b/tests/e2e/design-disabled-cursor.spec.ts
@@ -0,0 +1,113 @@
+import { test, expect, type Page } from "@playwright/test";
+
+// デザイン states.dc.html の注記「押せない時は、マウスの形も『押せない』にそろえる」。
+// 以前は pointer-events:none のため cursor:not-allowed が CSS にあっても実際には出なかった。
+// ポインタが届く要素（elementFromPoint）の computed cursor で測る。押せないままであることも確かめる。
+
+const errors = new WeakMap<Page, string[]>();
+
+test.beforeEach(async ({ page }) => {
+  const messages: string[] = [];
+  errors.set(page, messages);
+  page.on("pageerror", (error) => messages.push(error.message));
+  page.on("console", (message) => {
+    if (message.type() === "error") messages.push(message.text());
+  });
+  await page.goto("/");
+  await page.evaluate(() => document.fonts.ready);
+  await page.getByRole("textbox").fill("あ".repeat(200));
+});
+
+test.afterEach(async ({ page }) => {
+  expect(errors.get(page), "ブラウザの例外・console.error").toEqual([]);
+});
+
+for (const [name, selector] of [
+  ["X", ".share-button--x"],
+  ["LINE", ".share-button--line"],
+] as const) {
+  test(`${name}: 押せない時、マウスを乗せた先の cursor が not-allowed で、クリックしても何も開かない`, async ({
+    page,
+    context,
+  }) => {
+    const target = page.locator(selector);
+    await expect(target).toHaveAttribute("aria-disabled", "true");
+
+    // elementFromPoint は表示領域外だと null を返すため、先に画面内へ入れる。
+    await target.scrollIntoViewIfNeeded();
+    // ボタンの中心にポインタが届く要素（pointer-events:none だと背面の別要素になる）。
+    const box = (await target.boundingBox())!;
+    const hit = await page.evaluate(
+      ({ x, y }) => {
+        const el = document.elementFromPoint(x, y)!;
+        return { cls: el.className, cursor: getComputedStyle(el).cursor };
+      },
+      { x: box.x + box.width / 2, y: box.y + box.height / 2 },
+    );
+    expect(hit.cls, JSON.stringify(hit)).toContain("share-button");
+    expect(hit.cursor, JSON.stringify(hit)).toBe("not-allowed");
+
+    // 実際に hover しても同じ（hover 規則で cursor が上書きされない）。
+    await target.hover();
+    expect(await target.evaluate((el) => getComputedStyle(el).cursor)).toBe("not-allowed");
+
+    // 押せないまま: href が無く、Tab 順にも入らない。
+    await expect(target).not.toHaveAttribute("href");
+
+    // クリック（通常・中・Ctrl・Meta・Shift）とキー（Enter・Space）で、新しいタブも遷移も起きない。
+    // 入力に応じた URL 同期（?text=）が落ち着いてから基準を取る。
+    await expect(page.getByRole("status")).toHaveText(/共有はできません/);
+    await page.waitForTimeout(500);
+    const urlBefore = page.url();
+    const textbox = page.getByRole("textbox");
+    await textbox.focus();
+    let opened = 0;
+    context.on("page", () => opened++);
+    const focusOf = () =>
+      page.evaluate(() => `${document.activeElement?.tagName}.${document.activeElement?.className}`);
+    const focusBefore = await focusOf();
+    const clicks = [
+      {},
+      { button: "middle" as const },
+      { modifiers: ["Control" as const] },
+      { modifiers: ["Meta" as const] },
+      { modifiers: ["Shift" as const] },
+    ];
+    for (const options of clicks) {
+      await target.click(options);
+      // クリックでフォーカスが移らない（移ると後のキー操作で枠が出る）。
+      expect(await focusOf(), JSON.stringify(options)).toBe(focusBefore);
+    }
+    // Enter・Space はテキスト欄に入ると本文を書き換えるため、フォーカスを外してから押す。
+    await page.evaluate(() => (document.activeElement as HTMLElement).blur());
+    await page.keyboard.press("Enter");
+    await page.keyboard.press("Space");
+    await page.waitForTimeout(300);
+    expect(opened, "新しいタブが開いた").toBe(0);
+    expect(page.url()).toBe(urlBefore);
+    expect(context.pages()).toHaveLength(1);
+    expect(await target.evaluate((el) => el.matches(":focus-visible"))).toBe(false);
+    // tabindex を付けるとクリックでフォーカスできてしまう（Tab 順に入れない事は別テストで測る）。
+    await expect(target).not.toHaveAttribute("tabindex");
+  });
+}
+
+test("押せない X・LINE は Tab 順に入らない", async ({ page }) => {
+  await page.getByRole("button", { name: "📋 コピー", exact: true }).focus();
+  const visited: string[] = [];
+  for (let i = 0; i < 3; i++) {
+    await page.keyboard.press("Tab");
+    visited.push(await page.evaluate(() => document.activeElement?.className ?? ""));
+  }
+  expect(visited.join("|")).not.toMatch(/share-button--(x|line)/);
+  expect(visited[0]).toContain("share-button--link");
+});
+
+test("押せる時の X・LINE は pointer のまま（not-allowed にならない）", async ({ page }) => {
+  await page.getByRole("textbox").fill("短い入力");
+  for (const selector of [".share-button--x", ".share-button--line"]) {
+    const target = page.locator(selector);
+    await expect(target).toHaveAttribute("href", /text=/);
+    expect(await target.evaluate((el) => getComputedStyle(el).cursor)).toBe("pointer");
+  }
+});
diff --git a/tests/e2e/design-hover.spec.ts b/tests/e2e/design-hover.spec.ts
new file mode 100644
index 0000000..8017eab
--- /dev/null
+++ b/tests/e2e/design-hover.spec.ts
@@ -0,0 +1,94 @@
+import { test, expect, type Page } from "@playwright/test";
+
+// デザイン states.dc.html の「マウスを乗せた」列（.cph / .xh / .lnh / .lkh）の値。
+// 色は transition 中に途中の値を返しうるため、最終値になるまで expect.poll で待つ。
+
+const errors = new WeakMap<Page, string[]>();
+
+test.beforeEach(async ({ page }) => {
+  const messages: string[] = [];
+  errors.set(page, messages);
+  page.on("pageerror", (error) => messages.push(error.message));
+  page.on("console", (message) => {
+    if (message.type() === "error") messages.push(message.text());
+  });
+  await page.goto("/");
+  await page.evaluate(() => document.fonts.ready);
+});
+
+test.afterEach(async ({ page }) => {
+  expect(errors.get(page), "ブラウザの例外・console.error").toEqual([]);
+});
+
+function luminance(css: string): number {
+  const m = css.match(/[\d.]+/g)!.map(Number);
+  const [r, g, b] = m.slice(0, 3).map((v) => {
+    const c = v / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
+}
+function contrast(a: string, b: string): number {
+  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
+  return (hi! + 0.05) / (lo! + 0.05);
+}
+
+const buttons = {
+  copy: { selector: ".share-button--copy" },
+  x: { selector: ".share-button--x" },
+  line: { selector: ".share-button--line" },
+  link: { selector: ".share-button--link" },
+} as const;
+
+type Name = keyof typeof buttons;
+
+// ライトは --ach #1f47b8 / ダークは --ach #8ca0ff。X・LINE の塗りは両テーマ共通。
+const expected: Record<
+  "light" | "dark",
+  Record<Name, { bg: string; color: string; border?: string }>
+> = {
+  light: {
+    copy: { bg: "rgb(31, 71, 184)", color: "rgb(255, 255, 255)" },
+    x: { bg: "rgb(42, 47, 54)", color: "rgb(255, 255, 255)" },
+    line: { bg: "rgb(2, 106, 44)", color: "rgb(255, 255, 255)" },
+    link: { bg: "rgb(246, 248, 252)", color: "rgb(47, 95, 224)", border: "rgb(47, 95, 224)" },
+  },
+  dark: {
+    copy: { bg: "rgb(140, 160, 255)", color: "rgb(11, 14, 23)" },
+    x: { bg: "rgb(42, 47, 54)", color: "rgb(255, 255, 255)" },
+    line: { bg: "rgb(2, 106, 44)", color: "rgb(255, 255, 255)" },
+    link: { bg: "rgb(35, 40, 58)", color: "rgb(109, 139, 255)", border: "rgb(109, 139, 255)" },
+  },
+};
+
+for (const theme of ["light", "dark"] as const) {
+  for (const name of Object.keys(buttons) as Name[]) {
+    test(`${theme}: ${name} に hover した時の色がデザインどおり・文字コントラスト4.5以上`, async ({
+      page,
+    }) => {
+      await page.evaluate((t) => document.documentElement.setAttribute("data-theme", t), theme);
+      const target = page.locator(buttons[name].selector);
+      await target.hover();
+      const want = expected[theme][name];
+      const read = () =>
+        target.evaluate((el) => {
+          const s = getComputedStyle(el);
+          return {
+            bg: s.backgroundColor,
+            color: s.color,
+            border: s.borderTopColor,
+            filter: s.filter,
+          };
+        });
+      await expect
+        .poll(async () => (await read()).bg, { message: `${theme} ${name} 背景` })
+        .toBe(want.bg);
+      await expect.poll(async () => (await read()).color).toBe(want.color);
+      const final = await read();
+      // コピーの hover は色だけ。brightness フィルタを重ねるとデザインより明るくなる。
+      expect(final.filter, JSON.stringify(final)).toBe("none");
+      if (want.border) expect(final.border, JSON.stringify(final)).toBe(want.border);
+      expect(contrast(final.color, final.bg), JSON.stringify(final)).toBeGreaterThanOrEqual(4.5);
+    });
+  }
+}
diff --git a/tests/e2e/design-shape-container.spec.ts b/tests/e2e/design-shape-container.spec.ts
new file mode 100644
index 0000000..8547561
--- /dev/null
+++ b/tests/e2e/design-shape-container.spec.ts
@@ -0,0 +1,68 @@
+import { test, expect, type Page } from "@playwright/test";
+
+// デザイン差分監査 行15。デザイン(Screen.dc.html / Screen390.dc.html)は .shell（画面の列全体）を
+// container にして @container (max-width:480px) で 見出し 24px / カード余白 16px / 形選択 2列
+// に切り替える。ここでは列(.app-shell)の幅で判定されていることを測る。
+
+async function measure(page: Page) {
+  return page.evaluate(() => {
+    const shell = document.querySelector(".app-shell")!.getBoundingClientRect().width;
+    const card = getComputedStyle(document.querySelector(".card")!);
+    return {
+      shell,
+      cols: getComputedStyle(document.querySelector(".shape-picker")!).gridTemplateColumns.split(" ").length,
+      h1: getComputedStyle(document.querySelector(".app-title")!).fontSize,
+      padding: card.paddingLeft,
+    };
+  });
+}
+
+test.beforeEach(async ({ page }) => {
+  await page.goto("/");
+  await page.evaluate(() => document.fonts.ready);
+});
+
+test("列(.app-shell)が 480px 以下なら 2列・見出し24px・カード余白16px、超えたら 4列・32px・28px（画面幅 320〜800 を 1px ずつ）", async ({ page }) => {
+  let switchAt = 0;
+  for (let w = 320; w <= 800; w++) {
+    await page.setViewportSize({ width: w, height: 900 });
+    const m = await measure(page);
+    const narrow = m.shell <= 480;
+    expect(m, `viewport ${w}px / 列 ${m.shell}px`).toMatchObject(
+      narrow ? { cols: 2, h1: "24px", padding: "16px" } : { cols: 4, h1: "32px", padding: "28px" },
+    );
+    if (!narrow && !switchAt) switchAt = w;
+  }
+  // 列は画面幅 - 左右 16px。512px で列が 480px、513px で超える。
+  expect(switchAt).toBe(513);
+});
+
+for (const [width, cols] of [
+  [320, 2],
+  [390, 2],
+  [481, 2],
+  [512, 2],
+  [513, 4],
+  [560, 4],
+  [720, 4],
+  [1440, 4],
+] as const) {
+  test(`viewport ${width}px: ${cols} 列で、カード内・ページが横にはみ出さない`, async ({ page }) => {
+    await page.setViewportSize({ width, height: 900 });
+    expect((await measure(page)).cols).toBe(cols);
+    const overflow = await page.evaluate(() => {
+      const card = document.querySelector(".card")!.getBoundingClientRect();
+      const out: string[] = [];
+      for (const el of document.querySelectorAll(".card *")) {
+        if (el.closest(".preview-scroll")) continue; // AA は横スクロールが仕様。
+        const r = el.getBoundingClientRect();
+        if (r.width > 0 && (r.right > card.right + 0.5 || r.left < card.left - 0.5)) out.push(`${el.className || el.tagName}`);
+      }
+      return {
+        out,
+        pageScroll: document.documentElement.scrollWidth > innerWidth,
+      };
+    });
+    expect(overflow).toEqual({ out: [], pageScroll: false });
+  });
+}
