+import { test, expect, type Page } from "@playwright/test";
+
+// デザイン(design/project 版9)との差分監査 行1,2,3,4,8,10,12,13,14,46 の測定テスト。
+// rem で書いた値は 16px 基準の px に換算して getComputedStyle と比べる。
+
+type Theme = "light" | "dark";
+
+async function open(page: Page, theme: Theme, width: number) {
+  await page.setViewportSize({ width, height: 900 });
+  await page.addInitScript((t) => localStorage.setItem("sudden-death-theme", t), theme);
+  await page.goto("/");
+  await expect(page.locator("html")).toHaveAttribute("data-theme", theme);
+}
+
+const num = (v: string | undefined) => Number.parseFloat(v ?? "");
+
+const css = (page: Page, selector: string, props: string[]): Promise<Record<string, string>> =>
+  page.evaluate(
+    ([sel, ps]) => {
+      const s = getComputedStyle(document.querySelector(sel as string)!);
+      return Object.fromEntries((ps as string[]).map((p) => [p, s.getPropertyValue(p)]));
+    },
+    [selector, props],
+  ) as Promise<Record<string, string>>;
+
+test("ページ下余白: 1440 は 56px、390 は 32px（行1・2）", async ({ page }) => {
+  await open(page, "light", 1440);
+  expect((await css(page, "#app", ["padding-bottom"]))["padding-bottom"]).toBe("56px");
+  await open(page, "light", 390);
+  expect((await css(page, "#app", ["padding-bottom"]))["padding-bottom"]).toBe("32px");
+});
+
+test("h1 の line-height は 1.3（行3）", async ({ page }) => {
+  await open(page, "light", 1440);
+  const v = await css(page, ".app-title", ["line-height", "font-size"]);
+  expect(num(v["line-height"])).toBeCloseTo(num(v["font-size"]) * 1.3, 1);
+  expect(v["font-size"]).toBe("32px");
+});
+
+test("サブタイトルは 14px / 1.6 / balance（行4）", async ({ page }) => {
+  await open(page, "light", 390);
+  const v = await css(page, ".app-subtitle", ["font-size", "line-height", "text-wrap-style"]);
+  expect(v["font-size"]).toBe("14px");
+  expect(num(v["line-height"])).toBeCloseTo(22.4, 1);
+  expect(v["text-wrap-style"]).toBe("balance");
+});
+
+test("ラベルは 13.5px（行8）", async ({ page }) => {
+  await open(page, "light", 1440);
+  expect((await css(page, ".field-label", ["font-size"]))["font-size"]).toBe("13.5px");
+});
+
+for (const [theme, muted] of [
+  ["light", "rgb(91, 100, 120)"],
+  ["dark", "rgb(154, 162, 184)"],
+] as const) {
+  test(`${theme}: placeholder の色はミュートトークン（行12）`, async ({ page }) => {
+    await open(page, theme, 1440);
+    const color = await page.evaluate(() => getComputedStyle(document.querySelector(".editor-textarea")!, "::placeholder").color);
+    expect(color).toBe(muted);
+  });
+}
+
+test("スタイル選択ボタン: padding 12px 8px / gap 6px / 13.5px（行13）", async ({ page }) => {
+  await open(page, "light", 1440);
+  const v = await css(page, ".shape-button", ["padding-top", "padding-bottom", "padding-left", "padding-right", "row-gap", "font-size"]);
+  expect([v["padding-top"], v["padding-right"], v["padding-bottom"], v["padding-left"]]).toEqual(["12px", "8px", "12px", "8px"]);
+  expect(v["row-gap"]).toBe("6px");
+  expect(v["font-size"]).toBe("13.5px");
+});
+
+test("スタイル選択ボタンの高さはデザインの約 73px（±1px）、アイコン枠は 24px（行13）", async ({ page }) => {
+  for (const width of [1440, 390]) {
+    await open(page, "light", width);
+    const h = await page.evaluate(() => {
+      const b = document.querySelector(".shape-button")!;
+      return { button: b.getBoundingClientRect().height, icon: b.querySelector(".shape-icon")!.getBoundingClientRect().height };
+    });
+    expect(Math.abs(h.button - 73), `${width}px: ${h.button}`).toBeLessThanOrEqual(1);
+    expect(h.icon).toBe(24);
+  }
+});
+
+for (const [theme, act] of [
+  ["light", "rgb(233, 238, 252)"],
+  ["dark", "rgb(35, 43, 71)"],
+] as const) {
+  test(`${theme}: 選択中スタイルの背景は --act（行14）`, async ({ page }) => {
+    await open(page, theme, 1440);
+    const bg = await page.evaluate(() => getComputedStyle(document.querySelector('.shape-button[aria-checked="true"]')!).backgroundColor);
+    expect(bg).toBe(act);
+  });
+}
+
+test("注記は 12.5px / 1.7（行46）", async ({ page }) => {
+  await open(page, "light", 1440);
+  const v = await css(page, ".share-note", ["font-size", "line-height"]);
+  expect(v["font-size"]).toBe("12.5px");
+  expect(num(v["line-height"])).toBeCloseTo(21.25, 1);
+});
+
+for (const [theme, muted] of [
+  ["light", "rgb(91, 100, 120)"],
+  ["dark", "rgb(154, 162, 184)"],
+] as const) {
+  test(`${theme}: 無効の縦書きチェックはミュート色 + not-allowed、有効側は変えない（行10）`, async ({ page }) => {
+    await open(page, theme, 390);
+    const vertical = page.locator(".checkbox-label", { hasText: "縦書き" });
+    const enabledColor = await vertical.evaluate((e) => getComputedStyle(e).color);
+    expect(await vertical.evaluate((e) => getComputedStyle(e).cursor)).toBe("pointer");
+    await page.getByRole("radio", { name: "ストレス", exact: true }).click();
+    await expect(vertical.locator("input")).toBeDisabled();
+    const v = await vertical.evaluate((e) => ({ color: getComputedStyle(e).color, cursor: getComputedStyle(e).cursor }));
+    expect(v).toEqual({ color: muted, cursor: "not-allowed" });
+    expect(enabledColor).not.toBe(muted);
+    // 余白チェックは影響を受けない。
+    const other = page.locator(".checkbox-label", { hasText: "余白" });
+    expect(await other.evaluate((e) => getComputedStyle(e).cursor)).toBe("pointer");
+  });
+}
diff --git a/tests/e2e/followup-theme-media.spec.ts b/tests/e2e/followup-theme-media.spec.ts
new file mode 100644
index 0000000..4a3778a
--- /dev/null
+++ b/tests/e2e/followup-theme-media.spec.ts
@@ -0,0 +1,142 @@
+import { test, expect, type Page } from "@playwright/test";
+
+// #96 / G2 のレビューで残った穴を埋める追加テスト。いずれも「今の挙動」を固定するもので、
+// 実装は変えていない（変更前でも通る）。
+
+const errors = new WeakMap<Page, string[]>();
+
+test.afterEach(async ({ page }) => {
+  expect(errors.get(page), "ブラウザの例外・console.error").toEqual([]);
+});
+
+async function open(page: Page, scheme?: "light" | "dark") {
+  const messages: string[] = [];
+  errors.set(page, messages);
+  page.on("pageerror", (error) => messages.push(error.message));
+  page.on("console", (message) => {
+    if (message.type() === "error") messages.push(message.text());
+  });
+  // goto より前に OS 設定を決める。localStorage は新規コンテキストなので空（手動選択なし）。
+  if (scheme) await page.emulateMedia({ colorScheme: scheme });
+  await page.goto("/");
+  await page.evaluate(() => document.fonts.ready);
+}
+
+function luminance(css: string): number {
+  const m = css.match(/[\d.]+/g)!.map(Number);
+  const [r, g, b] = m.slice(0, 3).map((v) => {
+    const c = v / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
+}
+function contrast(a: string, b: string): number {
+  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
+  return (hi! + 0.05) / (lo! + 0.05);
+}
+
+// --- 1. data-theme が無い時の prefers-color-scheme フォールバック ---
+// アプリは useTheme の effect が起動直後に必ず data-theme を付ける（手動選択が無くても
+// OS の値を反映する）ため、そのままでは CSS の media フォールバックは使われない。
+// フォールバックそのものを測るには、読み込み後に属性を外して CSS だけの結果を見る。
+// emulateMedia の切り替えは useTheme の change リスナーが data-theme を付け直すので、
+// ライト/ダークは別々のページ読み込みで測る（競合を避ける）。
+const fallback = {
+  dark: { xBorder: "rgb(86, 94, 122)", copyBg: "rgb(109, 139, 255)" },
+  light: { xBorder: "rgb(20, 23, 26)", copyBg: "rgb(47, 95, 224)" },
+} as const;
+
+for (const scheme of ["dark", "light"] as const) {
+  test(`data-theme 無し・OS が ${scheme}: CSS の media フォールバックで X の枠線とコピーの塗りが決まる`, async ({
+    page,
+  }) => {
+    await open(page, scheme);
+    // 手動選択が無いので、アプリが付けた data-theme は OS の値と一致しているはず。
+    expect(
+      await page.evaluate(() => localStorage.getItem("sudden-death-theme")),
+    ).toBeNull();
+    await page.evaluate(() =>
+      document.documentElement.removeAttribute("data-theme"),
+    );
+    expect(
+      await page.evaluate(() =>
+        document.documentElement.hasAttribute("data-theme"),
+      ),
+    ).toBe(false);
+    const x = page.locator(".share-button--x");
+    const copy = page.locator(".share-button--copy");
+    await expect
+      .poll(() => x.evaluate((el) => getComputedStyle(el).borderTopColor), {
+        message: "X 枠線",
+      })
+      .toBe(fallback[scheme].xBorder);
+    await expect
+      .poll(() => copy.evaluate((el) => getComputedStyle(el).backgroundColor), {
+        message: "コピー背景",
+      })
+      .toBe(fallback[scheme].copyBg);
+  });
+}
+
+// --- 2. :active は今の押し込み（1px 下へ）のまま ---
+for (const name of ["copy", "x", "line", "link"] as const) {
+  test(`${name}: mousedown 中の transform は translateY(1px)`, async ({
+    page,
+  }) => {
+    await open(page);
+    const target = page.locator(`.share-button--${name}`);
+    await expect(target).toBeVisible();
+    if (name === "link") await expect(target).toBeEnabled();
+    else await expect(target).not.toHaveAttribute("aria-disabled", "true");
+    await target.hover();
+    await page.mouse.down();
+    try {
+      await expect
+        .poll(() => target.evaluate((el) => getComputedStyle(el).transform), {
+          message: `${name} :active`,
+        })
+        .toBe("matrix(1, 0, 0, 1, 0, 1)");
+    } finally {
+      // 要素の外で離して click を発火させない（X/LINE は別タブを開くため）。
+      await page.mouse.move(0, 0);
+      await page.mouse.up();
+    }
+    await expect
+      .poll(() => target.evaluate((el) => getComputedStyle(el).transform))
+      .toBe("none");
+  });
+}
+
+// --- 3. ダークで X / LINE に hover しても文字コントラストが落ちず、X の枠線は変わらない ---
+for (const name of ["x", "line"] as const) {
+  test(`dark: ${name} に hover しても文字コントラスト4.5以上${name === "x" ? "・枠線は #565e7a のまま" : ""}`, async ({
+    page,
+  }) => {
+    await open(page);
+    await page.evaluate(() =>
+      document.documentElement.setAttribute("data-theme", "dark"),
+    );
+    const target = page.locator(`.share-button--${name}`);
+    await target.hover();
+    const read = () =>
+      target.evaluate((el) => {
+        const s = getComputedStyle(el);
+        return {
+          bg: s.backgroundColor,
+          color: s.color,
+          border: s.borderTopColor,
+        };
+      });
+    // hover の塗りに遷移し終えるまで待つ（transition 中の途中色で測らない）。
+    await expect
+      .poll(async () => (await read()).bg)
+      .toBe(name === "x" ? "rgb(42, 47, 54)" : "rgb(2, 106, 44)");
+    const final = await read();
+    expect(
+      contrast(final.color, final.bg),
+      JSON.stringify(final),
+    ).toBeGreaterThanOrEqual(4.5);
+    if (name === "x")
+      expect(final.border, JSON.stringify(final)).toBe("rgb(86, 94, 122)");
+  });
+}
diff --git a/tests/e2e/icons.spec.ts b/tests/e2e/icons.spec.ts
new file mode 100644
index 0000000..f6abfa8
--- /dev/null
+++ b/tests/e2e/icons.spec.ts
@@ -0,0 +1,115 @@
+import { test, expect, type Page } from "@playwright/test";
+
+// des-07: アイコンは絵文字ではなく、文字色（currentColor）に従う線の SVG にする。
+// 端末ごとに絵柄が変わらない事・テーマで色が変わる事・絵文字が画面の文字に残っていない事を測る。
+
+const EMOJI = /\p{Extended_Pictographic}/u;
+
+async function visibleText(page: Page) {
+  return page.evaluate(() => document.body.innerText);
+}
+
+test("通常・コピー成功・コピー失敗・長文入力のどの状態でも、画面の文字に絵文字が無い", async ({ page }) => {
+  await page.goto("/");
+  await page.getByRole("textbox").fill("復帰");
+  expect(await visibleText(page)).not.toMatch(EMOJI);
+
+  await page.getByRole("button", { name: "コピー", exact: true }).click();
+  await expect(page.getByRole("status")).toHaveText(/コピーしました$/);
+  expect(await visibleText(page)).not.toMatch(EMOJI);
+
+  // 失敗: clipboard 書き込みを失敗させる
+  await page.evaluate(() => {
+    Object.defineProperty(navigator.clipboard, "writeText", { value: () => Promise.reject(new Error("denied")), configurable: true });
+  });
+  await expect(page.locator('[role="status"]:not(:empty)')).toHaveCount(0, { timeout: 5000 });
+  await page.getByRole("button", { name: "コピー", exact: true }).click();
+  await expect(page.getByRole("status")).toContainText("コピーできませんでした");
+  expect(await visibleText(page)).not.toMatch(EMOJI);
+  // 失敗の知らせはデザイン（states.dc.html）どおり色と文言だけで、絵（svg）を持たない。
+  await expect(page.getByRole("status").locator("svg")).toHaveCount(0);
+
+  await page.getByRole("textbox").fill("長い入力".repeat(200));
+  await expect(page.getByRole("status")).toHaveText("入力が長すぎるため、X・LINEでの共有はできません");
+  expect(await visibleText(page)).not.toMatch(EMOJI);
+});
+
+test("形の選択・コピー・リンク・テーマ切替のアイコンは currentColor の inline svg で aria-hidden", async ({ page }) => {
+  await page.goto("/");
+  const buttons = [
+    ...["通常", "四角形", "短冊", "ストレス"].map((n) => page.getByRole("radio", { name: n })),
+    page.getByRole("button", { name: "コピー", exact: true }),
+    page.getByRole("button", { name: "リンクをコピー" }),
+    page.getByRole("button", { name: /に切り替え$/ }),
+  ];
+  for (const button of buttons) {
+    const svg = button.locator("svg");
+    await expect(svg).toHaveCount(1);
+    await expect(svg).toHaveAttribute("aria-hidden", "true");
+    await expect(svg).toHaveAttribute("stroke", "currentColor");
+    await expect(svg).toHaveAttribute("fill", "none");
+  }
+});
+
+test("アイコンの色は文字色に従い、明暗を切り替えると変わる", async ({ page }) => {
+  await page.goto("/");
+  const read = () =>
+    page.evaluate(() => {
+      const pick = (el: Element) => {
+        const svg = el.querySelector("svg")!;
+        return { button: getComputedStyle(el).color, icon: getComputedStyle(svg).color };
+      };
+      return {
+        theme: document.documentElement.dataset.theme ?? "",
+        toggle: pick(document.querySelector(".theme-toggle")!),
+        radio: pick(document.querySelector('[role="radio"]')!),
+        link: pick(document.querySelector(".share-button--link")!),
+      };
+    });
+  // .shape-button などは color に 0.15s の transition があり、切替直後は途中の色を読んでしまう。
+  // 製品 CSS は変えず、色が落ち着く（250ms 空けた2回の読みが一致する）まで待ってから比べる。
+  const settled = async () => {
+    let result = await read();
+    await expect
+      .poll(async () => {
+        const before = JSON.stringify(result);
+        await page.waitForTimeout(250);
+        result = await read();
+        return JSON.stringify(result) === before;
+      })
+      .toBe(true);
+    return result;
+  };
+  const toggle = page.locator(".theme-toggle");
+  const first = await settled();
+  await toggle.click();
+  await expect.poll(async () => (await read()).theme).not.toBe(first.theme);
+  const second = await settled();
+  for (const key of ["toggle", "radio", "link"] as const) {
+    expect(first[key].icon).toBe(first[key].button);
+    expect(second[key].icon).toBe(second[key].button);
+    expect(first[key].icon).not.toBe(second[key].icon);
+  }
+});
+
+test("コピー成功の直後、コピー・リンクのボタンはチェックの svg と「コピー済み」を出し、知らせにもチェックが付く", async ({ page }) => {
+  await page.goto("/");
+  await page.getByRole("textbox").fill("復帰");
+  const checkPath = 'path[d="M5 12l5 5 9-10"]';
+
+  await page.getByRole("button", { name: "コピー", exact: true }).click();
+  const copied = page.getByRole("button", { name: "コピー済み" });
+  await expect(copied).toHaveCount(1);
+  await expect(copied.locator(`svg ${checkPath}`)).toHaveCount(1);
+  await expect(page.getByRole("status").locator(`svg ${checkPath}`)).toHaveCount(1);
+  await expect(page.getByRole("status")).toHaveText("コピーしました");
+});
+
+test("リンクコピー成功の直後もチェックの svg と「コピー済み」になる", async ({ page }) => {
+  await page.goto("/");
+  await page.getByRole("textbox").fill("復帰");
+  await page.getByRole("button", { name: "リンクをコピー" }).click();
+  const copied = page.getByRole("button", { name: "コピー済み" });
+  await expect(copied).toHaveCount(1);
+  await expect(copied.locator('svg path[d="M5 12l5 5 9-10"]')).toHaveCount(1);
+});
diff --git a/tests/e2e/share-disabled-reason.spec.ts b/tests/e2e/share-disabled-reason.spec.ts
new file mode 100644
index 0000000..7015698
--- /dev/null
+++ b/tests/e2e/share-disabled-reason.spec.ts
@@ -0,0 +1,80 @@
+import { test, expect, type Page } from "@playwright/test";
+
+// 長い入力で X・LINE が押せなくなった時の理由を、押せないボタンのすぐ下に見せる（ux-04）。
+// 以前は title に入れていたが、pointer-events:none と tabIndex=-1 のため誰にも表示されなかった。
+// 実測値（getBoundingClientRect）で「見えている・ボタンの直下・title が無い・高さが動かない」を確かめる。
+
+const REASON = "入力が長すぎるため、X・LINEでの共有はできません";
+const LONG_INPUT = "あ".repeat(200);
+
+async function measure(page: Page) {
+  return page.evaluate(() => {
+    const card = document.querySelector(".card")!.getBoundingClientRect();
+    const bar = document.querySelector(".share-bar")!.getBoundingClientRect();
+    const x = document.querySelector(".share-button--x")!.getBoundingClientRect();
+    const line = document.querySelector(".share-button--line")!.getBoundingClientRect();
+    const row = document.querySelector('[role="status"]')!;
+    const r = row.getBoundingClientRect();
+    return {
+      cardHeight: card.height,
+      barBottom: bar.bottom,
+      buttonsBottom: Math.max(x.bottom, line.bottom),
+      row: { top: r.top, height: r.height, text: row.textContent ?? "" },
+      pageWidth: Math.max(document.documentElement.scrollWidth, document.body.scrollWidth),
+      viewport: document.documentElement.clientWidth,
+      titles: [".share-button--x", ".share-button--line"].map((s) => document.querySelector(s)!.getAttribute("title")),
+      disabled: [".share-button--x", ".share-button--line"].map((s) => document.querySelector(s)!.getAttribute("aria-disabled")),
+    };
+  });
+}
+
+for (const [width, height] of [
+  [1440, 900],
+  [390, 844],
+] as const) {
+  test(`${width}px: 200字で X・LINE が押せない時、理由がボタンの直下に見え、title は無く、カードの高さが動かない`, async ({ page }) => {
+    await page.setViewportSize({ width, height });
+    await page.goto("/");
+    await page.getByRole("textbox").fill(LONG_INPUT);
+
+    const reason = page.getByRole("status");
+    await expect(reason).toHaveText(REASON);
+    await expect(reason).toBeVisible();
+    const withReason = await measure(page);
+
+    // X・LINE は押せない状態で、title（誰にも見えない説明）は付いていない。
+    expect(withReason.disabled).toEqual(["true", "true"]);
+    expect(withReason.titles).toEqual([null, null]);
+
+    // 理由は X・LINE のすぐ下（隙間 16px 以内）で、行の高さを先に確保している。
+    expect(withReason.row.top).toBeGreaterThanOrEqual(withReason.buttonsBottom);
+    expect(withReason.row.top - withReason.barBottom).toBeLessThanOrEqual(16);
+    expect(withReason.row.height).toBeGreaterThanOrEqual(24);
+    // 画面の中に収まっている（折り返しても行からはみ出さない）。
+    expect(withReason.pageWidth).toBeLessThanOrEqual(withReason.viewport);
+
+    // コピーの知らせが同じ行に出て消えても、理由に戻り、カードの高さと行の位置は同じ。
+    await page.getByRole("button", { name: "コピー", exact: true }).click();
+    await expect(reason).toHaveText(/コピーしました$/);
+    const during = await measure(page);
+    await expect(reason).toHaveText(REASON);
+    const after = await measure(page);
+
+    expect(during.cardHeight).toBe(withReason.cardHeight);
+    expect(after.cardHeight).toBe(withReason.cardHeight);
+    expect(during.row.top).toBe(withReason.row.top);
+    expect(after.row.top).toBe(withReason.row.top);
+    expect(during.row.height).toBe(withReason.row.height);
+
+    // 短い入力（理由なし）の空の行と高さが同じ＝理由が出ても行が伸びない。
+    await page.getByRole("textbox").fill("復帰");
+    await expect(page.locator('[role="status"]:not(:empty)')).toHaveCount(0);
+    const idle = await measure(page);
+    expect(withReason.row.height).toBe(idle.row.height);
+
+    test.info().annotations.push({
+      type: "measure",
+      description: `rowTop=${withReason.row.top} buttonsBottom=${withReason.buttonsBottom} barBottom=${withReason.barBottom} rowH=${withReason.row.height} idleRowH=${idle.row.height} card=${withReason.cardHeight}/${during.cardHeight}/${after.cardHeight}`,
+    });
+  });
+}
diff --git a/tests/e2e/share-note-gap.spec.ts b/tests/e2e/share-note-gap.spec.ts
new file mode 100644
