+import { describe, expect, it } from "vitest";
+import { buildPermalinkQuery, parsePermalink } from "./permalink";
+import { renderSuddenDeath } from "./render";
+import {
+  SHAPE_KINDS,
+  SHAPE_TABLE,
+  isShapeKind,
+  isVerticalDisabled,
+  isVerticalMeaningful,
+  resolveVertical,
+  verticalHintOf,
+  verticalRuleOf,
+} from "./shape";
