--- /dev/null
+++ b/tests/e2e/share-note-gap.spec.ts
@@ -0,0 +1,25 @@
+import { test, expect } from "@playwright/test";
+
+// 共有ボタン群の下端と注記（.share-note）の間は 8px 以上空ける（des-04）。
+// 以前は .share-note が margin 0 でボタンに貼り付いていた。知らせの行（高さ確保済み）が
+// 間に入る今は、その行が隙間になる。主要幅すべてで実測して確かめる。
+
+const MIN_GAP = 8;
+
+for (const width of [320, 390, 481, 560, 641, 720, 768, 1024, 1440]) {
+  test(`${width}px: 共有ボタンの下端と注記の間が ${MIN_GAP}px 以上`, async ({ page }) => {
+    await page.setViewportSize({ width, height: 900 });
+    await page.goto("/");
+    await page.getByRole("textbox").fill("復帰");
+
+    const m = await page.evaluate(() => {
+      const bottoms = [...document.querySelectorAll(".share-button")].map((b) => b.getBoundingClientRect().bottom);
+      const note = document.querySelector(".share-note")!.getBoundingClientRect();
+      return { buttonsBottom: Math.max(...bottoms), noteTop: note.top };
+    });
+    const gap = m.noteTop - m.buttonsBottom;
+    test.info().annotations.push({ type: "measure", description: `gap=${gap}` });
+    console.log(`width=${width} gap=${gap}`);
+    expect(gap).toBeGreaterThanOrEqual(MIN_GAP);
+  });
+}
diff --git a/tests/e2e/share-notice.spec.ts b/tests/e2e/share-notice.spec.ts
new file mode 100644
index 0000000..9f99096
--- /dev/null
+++ b/tests/e2e/share-notice.spec.ts
@@ -0,0 +1,116 @@
+import { test, expect, type Page } from "@playwright/test";
+
+// コピー成功の知らせは共有ボタンのすぐ下の「先に高さを確保した行」に出す（des-05）。
+// 出ても消えてもカードの高さが変わらない事と、知らせが共有ボタン群の直下にある事を
+// 実測値（getBoundingClientRect）で確かめる。
+
+const NOTICE_ROW_HEIGHT = 24; // design/project/states.dc.html の min-height
+
+async function measure(page: Page) {
+  return page.evaluate(() => {
+    const card = document.querySelector(".card")!.getBoundingClientRect();
+    const bar = document.querySelector(".share-bar")!.getBoundingClientRect();
+    const notice = document.querySelector('[role="status"]')?.getBoundingClientRect();
+    return {
+      cardHeight: card.height,
+      barBottom: bar.bottom,
+      notice: notice ? { top: notice.top, height: notice.height } : null,
+      pageWidth: Math.max(document.documentElement.scrollWidth, document.body.scrollWidth),
+      viewport: document.documentElement.clientWidth,
+    };
+  });
+}
+
+for (const [width, height] of [
+  [1440, 900],
+  [390, 844],
+] as const) {
+  test(`${width}px: 知らせが出る前・出ている間・消えた後でカードの高さが同じで、共有ボタンの直下に出る`, async ({ page }) => {
+    await page.setViewportSize({ width, height });
+    await page.goto("/");
+    await page.getByRole("textbox").fill("復帰");
+    await expect(page.getByRole("button", { name: /リンクをコピー/ })).toBeEnabled();
+
+    const before = await measure(page);
+    await page.getByRole("button", { name: "コピー", exact: true }).click();
+    await expect(page.getByRole("status")).toHaveText(/コピーしました$/);
+    const during = await measure(page);
+    await expect(page.locator('[role="status"]:not(:empty)')).toHaveCount(0);
+    const after = await measure(page);
+
+    expect(during.cardHeight).toBe(before.cardHeight);
+    expect(after.cardHeight).toBe(before.cardHeight);
+
+    // 知らせの行は共有ボタン群のすぐ下（隙間は 16px 以内）にあり、高さ 24px を先に取っている。
+    expect(during.notice).not.toBeNull();
+    expect(during.notice!.top).toBeGreaterThanOrEqual(during.barBottom);
+    expect(during.notice!.top - during.barBottom).toBeLessThanOrEqual(16);
+    expect(during.notice!.height).toBeGreaterThanOrEqual(NOTICE_ROW_HEIGHT);
+    expect(before.notice!.height).toBe(during.notice!.height);
+
+    expect(during.pageWidth).toBeLessThanOrEqual(during.viewport);
+    // 390×844 では共有ボタンが縦積みなので知らせが画面外に出うる。値は報告用に出力する（#91 待ち）。
+    test.info().annotations.push({
+      type: "measure",
+      description: `before=${before.cardHeight} during=${during.cardHeight} after=${after.cardHeight} noticeTop=${during.notice!.top} barBottom=${during.barBottom}`,
+    });
+  });
+}
+
+// コピー失敗（クリップボードへの書き込みが拒否される）時も同じ行に出し、文言はデザイン
+// （states.dc.html）どおり。文字色はカード面に対して WCAG AA の 4.5:1 以上にする。
+function luminance(c: number[]) {
+  const [r, g, b] = [c[0]!, c[1]!, c[2]!];
+  const f = (v: number) => {
+    const s = v / 255;
+    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
+  };
+  return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
+}
+const rgb = (css: string) => (css.match(/[\d.]+/g) ?? []).slice(0, 3).map(Number);
+
+for (const [width, height] of [
+  [1440, 900],
+  [390, 844],
+] as const) {
+  for (const scheme of ["light", "dark"] as const) {
+    test(`${width}px ${scheme}: コピー失敗の知らせが同じ行に出て、カードの高さが変わらず、文字が 4.5:1 以上`, async ({
+      page,
+    }) => {
+      await page.emulateMedia({ colorScheme: scheme });
+      await page.setViewportSize({ width, height });
+      await page.addInitScript(() => {
+        Object.defineProperty(navigator, "clipboard", {
+          value: { writeText: () => Promise.reject(new Error("denied")) },
+        });
+      });
+      await page.goto("/");
+      await page.getByRole("textbox").fill("復帰");
+      const before = await measure(page);
+
+      await page.getByRole("button", { name: "コピー", exact: true }).click();
+      const status = page.getByRole("status");
+      await expect(status).toHaveText(/コピーできませんでした。もう一度押してください$/);
+      const during = await measure(page);
+
+      expect(during.cardHeight).toBe(before.cardHeight);
+      // 同じ行（成功時と同じ位置・高さ）に出る。折り返して行が伸びていない。
+      expect(during.notice!.top).toBe(before.notice!.top);
+      expect(during.notice!.height).toBe(before.notice!.height);
+      expect(during.pageWidth).toBeLessThanOrEqual(during.viewport);
+
+      const colors = await page.evaluate(() => ({
+        fg: getComputedStyle(document.querySelector('[role="status"]')!).color,
+        bg: getComputedStyle(document.querySelector(".card")!).backgroundColor,
+      }));
+      const lums = [luminance(rgb(colors.fg)), luminance(rgb(colors.bg))].sort((a, b) => b - a);
+      const [l1, l2] = [lums[0]!, lums[1]!];
+      const ratio = (l1 + 0.05) / (l2 + 0.05);
+      test.info().annotations.push({
+        type: "measure",
+        description: `fg=${colors.fg} bg=${colors.bg} ratio=${ratio.toFixed(2)} noticeH=${during.notice!.height} cardH=${during.cardHeight}`,
+      });
+      expect(ratio).toBeGreaterThanOrEqual(4.5);
+    });
+  }
+}
diff --git a/tests/e2e/share-style.spec.ts b/tests/e2e/share-style.spec.ts
new file mode 100644
index 0000000..19aae19
--- /dev/null
+++ b/tests/e2e/share-style.spec.ts
@@ -0,0 +1,132 @@
+import { test, expect, type Page } from "@playwright/test";
+
+const errors = new WeakMap<Page, string[]>();
+
+test.beforeEach(async ({ page }) => {
+  const messages: string[] = [];
+  errors.set(page, messages);
+  page.on("pageerror", (error) => messages.push(error.message));
+  page.on("console", (message) => {
+    if (message.type() === "error") messages.push(message.text());
+  });
+  await page.goto("/");
+  await page.evaluate(() => document.fonts.ready);
+});
+
+test.afterEach(async ({ page }) => {
+  expect(errors.get(page), "ブラウザの例外・console.error").toEqual([]);
+});
+
+test("共有ボタン4つのラベルに下線が出ない（a 要素の X/LINE も button と同じ）", async ({ page }) => {
+  const buttons = page.locator(".share-bar .share-button");
+  await expect(buttons).toHaveCount(4);
+  // a 要素は UA 既定で underline になる。button との差が出ていないかを computed style で測る。
+  const decorations = await buttons.evaluateAll((elements) =>
+    elements.map((element) => ({
+      tag: element.tagName,
+      line: getComputedStyle(element).textDecorationLine,
+    })),
+  );
+  expect(decorations.map((d) => d.tag)).toEqual(["BUTTON", "A", "A", "BUTTON"]);
+  for (const d of decorations) expect(d.line, d.tag).toBe("none");
+});
+
+// 2列になる幅（ラベルが折り返さない幅）。4列幅の折り返しは別 PBI（#91 並びの決定待ち）で扱う。
+for (const width of [481, 560, 640]) {
+  test(`${width}px: 共有ボタン4つの枠線の太さと高さ(48px)がそろう`, async ({ page }) => {
+    await page.setViewportSize({ width, height: 900 });
+    const buttons = page.locator(".share-bar .share-button");
+    await expect(buttons).toHaveCount(4);
+    const metrics = await buttons.evaluateAll((elements) =>
+      elements.map((element) => ({
+        border: getComputedStyle(element).borderTopWidth,
+        height: element.getBoundingClientRect().height,
+      })),
+    );
+    // 「リンクをコピー」だけ枠線を持つと 2px 高くなり、2段目と1段目で高さがずれていた。
+    expect(new Set(metrics.map((m) => m.border)).size, JSON.stringify(metrics)).toBe(1);
+    expect(parseFloat(metrics[0]?.border ?? "0")).toBeGreaterThan(0);
+    for (const m of metrics) expect(m.height, JSON.stringify(metrics)).toBe(48);
+  });
+}
+
+// --- X ボタンの枠線（ダーク）。デザインの --xbd。 ---
+function luminance(css: string): number {
+  const m = css.match(/[\d.]+/g)!.map(Number);
+  const [r, g, b] = m.slice(0, 3).map((v) => {
+    const c = v / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r! + 0.7152 * g! + 0.0722 * b!;
+}
+function contrast(a: string, b: string): number {
+  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
+  return (hi! + 0.05) / (lo! + 0.05);
+}
+
+for (const theme of ["light", "dark"] as const) {
+  test(`${theme}: X ボタンの枠線・文字色`, async ({ page }) => {
+    await page.evaluate((t) => document.documentElement.setAttribute("data-theme", t), theme);
+    const x = await page.locator(".share-button--x").evaluate((el) => {
+      const s = getComputedStyle(el);
+      return {
+        border: s.borderTopColor,
+        width: s.borderTopWidth,
+        bg: s.backgroundColor,
+        color: s.color,
+        card: getComputedStyle(el.closest(".card") ?? document.body).backgroundColor,
+      };
+    });
+    // DPR1 では 1.5px が 1px に丸められて返るため、枠線があること（>0）だけ見る。
+    expect(parseFloat(x.width)).toBeGreaterThan(0);
+    expect(x.bg).toBe("rgb(20, 23, 26)");
+    // 文字と塗りのコントラストは WCAG 1.4.3 の 4.5:1 以上
+    expect(contrast(x.color, x.bg), JSON.stringify(x)).toBeGreaterThanOrEqual(4.5);
+    if (theme === "light") {
+      // ライトは従来と同じ見た目（枠線は塗りと同色）
+      expect(x.border).toBe("rgb(20, 23, 26)");
+    } else {
+      expect(x.border).toBe("rgb(86, 94, 122)");
+      // 閾値 2.5:1（デザイン値は 2.59:1。3:1 未達は PR で明示）
+      expect(contrast(x.border, x.card), JSON.stringify(x)).toBeGreaterThanOrEqual(2.5);
+    }
+  });
+}
+
+// --- 「コピー」を主操作のアクセント色にする（緑は LINE と成功の知らせだけ）。デザインの --ac / --onac。 ---
+const expected = {
+  light: { copy: "rgb(47, 95, 224)", copyText: "rgb(255, 255, 255)" },
+  dark: { copy: "rgb(109, 139, 255)", copyText: "rgb(11, 14, 23)" },
+} as const;
+
+for (const theme of ["light", "dark"] as const) {
+  test(`${theme}: コピーはアクセント色の塗り・LINE は緑のまま・4つとも文字コントラスト4.5以上`, async ({
+    page,
+  }) => {
+    await page.evaluate((t) => document.documentElement.setAttribute("data-theme", t), theme);
+    const styles = await page.locator(".share-bar .share-button").evaluateAll((els) =>
+      els.map((el) => {
+        const s = getComputedStyle(el);
+        return { cls: el.className, bg: s.backgroundColor, color: s.color };
+      }),
+    );
+    const by = (c: string) => styles.find((s) => s.cls.includes(c))!;
+    const copy = by("share-button--copy");
+    const accent = await page.evaluate(() =>
+      getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim(),
+    );
+    expect(copy.bg, JSON.stringify(copy)).toBe(expected[theme].copy);
+    expect(copy.color).toBe(expected[theme].copyText);
+    // トークン（アプリのアクセント色）と同じ値であること。hex を rgb に直して比べる。
+    const hex = accent.replace("#", "");
+    const rgb = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(", ");
+    expect(copy.bg).toBe(`rgb(${rgb})`);
+    // LINE は緑のまま（コピーと見分けがつく）
+    expect(by("share-button--line").bg).toBe("rgb(3, 122, 51)");
+    expect(copy.bg).not.toBe(by("share-button--line").bg);
+    expect(styles).toHaveLength(4);
+    for (const s of styles) {
+      expect(contrast(s.color, s.bg), JSON.stringify(s)).toBeGreaterThanOrEqual(4.5);
+    }
+  });
+}
